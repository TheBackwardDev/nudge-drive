<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Nudge" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/nd_splash</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.Nudge.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/nd_splash</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="postSplashScreenTheme">@style/Theme.Nudge</item>
    </style>
</resources>
