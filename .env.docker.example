# Copy to .env and fill in. Never commit .env.
# Generate random secrets with:  openssl rand -hex 32

# Database (the mysql container creates these on first start)
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=nudge
MYSQL_USER=nudge
MYSQL_PASSWORD=change-this-database-password

# Public addresses. For a local test keep the localhost values.
# Production behind Caddy: DOMAIN=drive.example.com and FRONTEND_URL=https://drive.example.com
# (VITE_API_URL is not used by the current web app; it always calls /api on its own origin.)
DOMAIN=drive.example.com
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:4000
VITE_RECAPTCHA_SITE_KEY=

# Secrets (at least 32 characters each)
JWT_ACCESS_SECRET=change-this-jwt-secret-at-least-32-chars
TOKEN_ENCRYPTION_KEY=change-this-encryption-key-32bytes!
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30
MAX_UPLOAD_BYTES=5368709120

# Google OAuth "Web application" client (see docs/self-hosting.md).
# Production: GOOGLE_REDIRECT_URI=https://drive.example.com/api/connected-accounts/google/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/connected-accounts/google/callback
# Folder in each Google Drive that new uploads go into (default: Nudge Drive).
# Upgrading an existing install? Set this to the folder name it already uses.
GOOGLE_APP_FOLDER=
RECAPTCHA_SECRET_KEY=

# Who may change server-wide settings (comma-separated emails of registered users)
ADMIN_EMAILS=you@example.com

# Email (verification codes, account deletion). Leave SMTP_USER/SMTP_PASS empty to turn email off.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Collabora Online admin console login (production compose only)
COLLABORA_ADMIN_USER=admin
COLLABORA_ADMIN_PASSWORD=change-this-collabora-password
